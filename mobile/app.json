{
  "expo": {
    "name": "BakedBoston",
    "slug": "bakedboston",
    "version": "1.0.0",
    "scheme": "bakedboston",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bakedboston.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BakedBoston uses your location while the app is open to calculate traffic-aware departure times for accepted deliveries.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bakedboston.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F4E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BakedBoston to select access photos for drivers.",
          "cameraPermission": "Allow BakedBoston to take access photos for drivers.",
          "microphonePermission": false
        }
      ],
      "expo-location",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "285e0275-ce08-402f-ae25-68a06ab86df3"
      }
    },
    "owner": "princesseva"
  }
}
